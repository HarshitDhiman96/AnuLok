PORT=5000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=anulok
JWT_SECRET=replace_with_a_long_random_secret

# Optional: creates the first admin account when the database has no admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=replace_with_a_strong_password

# Email OTP Verification (100% Free - Standard Gmail App Password or custom SMTP)
# Option A: Free Gmail App Password (recommended for simple setup):
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
#
# Option B: Custom Free SMTP Server (Brevo, Outlook, Mailtrap, etc.):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_smtp_password
#
# NOTE: If email credentials are not set, the OTP code is automatically logged
# directly to the server terminal console for frictionless local testing.
