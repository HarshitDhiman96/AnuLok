PORT=5000
FRONTEND_URL=https://www.anulokfurniture.shop
# Add any additional allowed browser origins as a comma-separated list.
# CORS_ORIGINS=http://localhost:5173,https://preview.example.vercel.app
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=anulok
JWT_SECRET=replace_with_a_long_random_secret

# Configure the administrator account. These credentials are applied at server startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=replace_with_a_strong_password
